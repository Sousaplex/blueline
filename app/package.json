{
  "name": "blueline-app",
  "version": "0.37.0",
  "description": "AI design studio for print marketing collateral",
  "author": "Blueline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "electron:compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=dist-electron --format=cjs --out-extension:.js=.cjs",
    "electron:dev": "npm run electron:compile && electron .",
    "electron:app": "npm run build && npm run electron:compile && electron .",
    "electron:smoke": "npm run build && npm run electron:compile && BLUELINE_SMOKE=1 electron .",
    "package": "npm run build && npm run electron:compile && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "package:signed": "npm run build && npm run electron:compile && electron-builder --mac",
    "release:publish": "npm run build && npm run electron:compile && electron-builder --mac --publish always",
    "test": "vitest run"
  },
  "//deps": "All build-time only: renderer deps are Vite-bundled into dist/, electron-updater is esbuild-bundled into main.cjs, shadcn is a codegen CLI, and the bridge child uses toolkit/node_modules — so NOTHING here is needed as app/node_modules at runtime. Keeping them in devDependencies stops electron-builder from shipping ~137MB of them.",
  "dependencies": {},
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "@electron/notarize": "^3.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron@43.1.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.blueline.app",
    "productName": "Blueline",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../toolkit",
        "to": "toolkit",
        "filter": [
          "src/**",
          "package.json",
          "tsconfig.json"
        ]
      },
      {
        "from": "../toolkit/node_modules",
        "to": "toolkit/node_modules"
      },
      {
        "from": "dist",
        "to": "app/dist"
      },
      {
        "from": "../config/providers.example.json",
        "to": "config/providers.example.json"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Sousaplex",
      "repo": "blueline"
    },
    "mac": {
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "afterSign": "build/notarize.cjs"
  }
}
